<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      TextOptions.TextFormattingMode="Ideal">
  <Grid.Resources>
    <FontFamily x:Key="UiFont">Segoe UI</FontFamily>
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- round icon buttons (prev / next / volume / open) and the accent play button -->
    <Style x:Key="CircleButton" TargetType="Button">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="#F2FFFFFF"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Width" Value="36"/>
      <Setter Property="Height" Value="36"/>
      <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <Border Background="{TemplateBinding Background}" CornerRadius="100"/>
              <Border x:Name="Hover" Background="#FFFFFFFF" Opacity="0" CornerRadius="100"/>
              <ContentPresenter x:Name="Cp" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Hover" Property="Opacity" Value="0.13"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Hover" Property="Opacity" Value="0.22"/>
                <Setter TargetName="Cp" Property="RenderTransform">
                  <Setter.Value><ScaleTransform ScaleX="0.88" ScaleY="0.88"/></Setter.Value>
                </Setter>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.3"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- quick app tiles -->
    <Style x:Key="AppButton" TargetType="Button">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Width" Value="42"/>
      <Setter Property="Height" Value="42"/>
      <Setter Property="Foreground" Value="#F2FFFFFF"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid Background="Transparent">
              <Border x:Name="Hover" Background="#FFFFFFFF" Opacity="0" CornerRadius="12"/>
              <ContentPresenter x:Name="Cp" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Hover" Property="Opacity" Value="0.1"/>
                <Setter TargetName="Cp" Property="RenderTransform">
                  <Setter.Value><ScaleTransform ScaleX="1.1" ScaleY="1.1"/></Setter.Value>
                </Setter>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Cp" Property="RenderTransform">
                  <Setter.Value><ScaleTransform ScaleX="0.9" ScaleY="0.9"/></Setter.Value>
                </Setter>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- content-only button (album art) -->
    <Style x:Key="BareButton" TargetType="Button">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <ContentPresenter x:Name="Cp" RenderTransformOrigin="0.5,0.5"/>
            <ControlTemplate.Triggers>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Cp" Property="RenderTransform">
                  <Setter.Value><ScaleTransform ScaleX="0.94" ScaleY="0.94"/></Setter.Value>
                </Setter>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- plain text button ("Clear") -->
    <Style x:Key="TextButton" TargetType="Button">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="#80FFFFFF"/>
      <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="Transparent" Padding="4,1">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="#FFFFFFFF"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- small pill showing the source app -->
    <Style x:Key="ChipButton" TargetType="Button">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="#D9FFFFFF"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bg" Background="Transparent" CornerRadius="8" Padding="4">
              <ContentPresenter x:Name="Cp" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="#1AFFFFFF"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Cp" Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="0.9" ScaleY="0.9"/></Setter.Value></Setter>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Grid.Resources>

  <Grid x:Name="IslandRoot" HorizontalAlignment="Center" VerticalAlignment="Top">
    <Path x:Name="Shape" Fill="#FF000000" HorizontalAlignment="Center" VerticalAlignment="Top" Stretch="None"/>
    <!-- edge: faint on the black pill, a bright glass rim (light catching the top) when the island is open -->
    <Path x:Name="Outline" StrokeThickness="1" HorizontalAlignment="Center" VerticalAlignment="Top"
          Stretch="None" IsHitTestVisible="False" Opacity="0.3">
      <Path.Stroke>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
          <GradientStop Color="#55FFFFFF" Offset="0"/>
          <GradientStop Color="#30FFFFFF" Offset="0.35"/>
          <GradientStop Color="#1CFFFFFF" Offset="1"/>
        </LinearGradientBrush>
      </Path.Stroke>
    </Path>
    <!-- iPhone-style privacy dot just outside the pill: orange = microphone, green = camera -->
    <Ellipse x:Name="PrivacyDot" Width="7" Height="7" HorizontalAlignment="Center" VerticalAlignment="Top"
             Fill="#FFFF9F0A" Visibility="Collapsed" IsHitTestVisible="False"/>

    <Grid x:Name="Body" HorizontalAlignment="Center" VerticalAlignment="Top">
      <!-- frosted glass (open island): the blurred screen behind, a dark tint for legible text, a top sheen -->
      <Canvas x:Name="GlassHost" Opacity="0" IsHitTestVisible="False">
        <Image x:Name="GlassImage" Stretch="Fill" RenderOptions.BitmapScalingMode="Linear">
          <Image.Effect><BlurEffect Radius="16" RenderingBias="Performance"/></Image.Effect>
        </Image>
      </Canvas>
      <Rectangle x:Name="GlassTint" Fill="#B00E0E12" Opacity="0" IsHitTestVisible="False"/>
      <Rectangle x:Name="GlassSheen" Opacity="0" IsHitTestVisible="False">
        <Rectangle.Fill>
          <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#1EFFFFFF" Offset="0"/>
            <GradientStop Color="#08FFFFFF" Offset="0.4"/>
            <GradientStop Color="#00FFFFFF" Offset="1"/>
          </LinearGradientBrush>
        </Rectangle.Fill>
      </Rectangle>
      <!-- blurred album color glow behind the expanded content (a 16px image stretched = free blur) -->
      <Image x:Name="Ambient" Stretch="UniformToFill" Opacity="0" IsHitTestVisible="False"
             RenderOptions.BitmapScalingMode="Linear"/>

      <!-- ===================== compact (pill) ===================== -->
      <Grid x:Name="Compact" Height="32" VerticalAlignment="Top">
        <TextBlock x:Name="IdleClock" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,1"
                   FontFamily="{StaticResource UiFont}" FontSize="13" FontWeight="SemiBold" Foreground="#F2FFFFFF"/>

        <Grid x:Name="CompactMedia" Margin="6,0,13,0" Visibility="Collapsed">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Border x:Name="CompactArt" Width="22" Height="22" CornerRadius="7" VerticalAlignment="Center"
                  Background="#33FFFFFF" RenderOptions.BitmapScalingMode="HighQuality"/>
          <TextBlock x:Name="CompactTitle" Grid.Column="1" Margin="9,0,10,1" VerticalAlignment="Center" Visibility="Collapsed"
                     FontFamily="{StaticResource UiFont}" FontSize="12" Foreground="#D9FFFFFF" TextTrimming="CharacterEllipsis"/>
          <StackPanel x:Name="CompactBars" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Height="14"/>
        </Grid>

        <!-- ongoing call: green phone on the left, green timer on the right (like the iPhone) -->
        <Grid x:Name="CompactCall" Margin="14,0,15,0" Visibility="Collapsed">
          <TextBlock x:Name="CallCompactIcon" Text="&#xE717;" FontFamily="{StaticResource IconFont}" FontSize="14"
                     Foreground="#FF30D158" HorizontalAlignment="Left" VerticalAlignment="Center"/>
          <TextBlock x:Name="CallCompactTimer" FontFamily="{StaticResource UiFont}" FontSize="12.5" FontWeight="SemiBold"
                     Foreground="#FF30D158" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,0,1"/>
        </Grid>

        <Grid x:Name="Hud" Margin="14,0,14,0" Visibility="Collapsed">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="HudIcon" VerticalAlignment="Center" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="#F2FFFFFF"/>
          <Grid Grid.Column="1" Margin="11,0,11,0" VerticalAlignment="Center">
            <TextBlock x:Name="HudLabel" FontFamily="{StaticResource UiFont}" FontSize="12.5" FontWeight="SemiBold"
                       Foreground="#F2FFFFFF" VerticalAlignment="Center" Margin="0,0,0,1" TextTrimming="CharacterEllipsis"/>
            <Grid x:Name="HudBar" Height="4" VerticalAlignment="Center">
              <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="HudDone" Width="1*"/>
                <ColumnDefinition x:Name="HudLeft" Width="1*"/>
              </Grid.ColumnDefinitions>
              <Border Grid.ColumnSpan="2" Background="#33FFFFFF" CornerRadius="2"/>
              <Border Background="#F2FFFFFF" CornerRadius="2"/>
            </Grid>
          </Grid>
          <TextBlock x:Name="HudValue" Grid.Column="2" MinWidth="22" TextAlignment="Right" VerticalAlignment="Center" Margin="0,0,0,1"
                     FontFamily="{StaticResource UiFont}" FontSize="12" FontWeight="SemiBold" Foreground="#CCFFFFFF"/>
        </Grid>
      </Grid>

      <!-- ===================== expanded ===================== -->
      <StackPanel x:Name="Expanded" Width="520" VerticalAlignment="Top" HorizontalAlignment="Center" Visibility="Hidden">

        <!-- earbuds / headphones connected (AirPods-style card) -->
        <Grid x:Name="ExpBuds" Margin="20,16,20,16" Visibility="Collapsed">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Border x:Name="BudsIconBox" Width="84" Height="84" CornerRadius="22" Background="#1FFFFFFF" RenderTransformOrigin="0.5,0.5">
            <TextBlock Text="&#xE7F6;" FontFamily="{StaticResource IconFont}" FontSize="30" Foreground="#FFFFFFFF"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <StackPanel Grid.Column="1" Margin="16,0,10,0" VerticalAlignment="Center">
            <TextBlock x:Name="BudsName" FontFamily="{StaticResource UiFont}" FontSize="16.5" FontWeight="SemiBold" Foreground="#FFFFFFFF"
                       TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="BudsSub" Text="Connected" FontFamily="{StaticResource UiFont}" FontSize="12.5" Foreground="#FF30D158" Margin="0,2,0,0"/>
          </StackPanel>
          <Grid x:Name="BudsRingBox" Grid.Column="2" Width="58" Height="58" VerticalAlignment="Center">
            <Ellipse Stroke="#26FFFFFF" StrokeThickness="5"/>
            <Path x:Name="BudsRing" Stroke="#FF30D158" StrokeThickness="5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            <TextBlock x:Name="BudsPct" FontFamily="{StaticResource UiFont}" FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFFFF"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,1"/>
          </Grid>
        </Grid>

        <!-- incoming call -->
        <Grid x:Name="ExpIncoming" Margin="16,14,16,14" Visibility="Collapsed">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="52"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Border Width="52" Height="52" CornerRadius="26" Background="#FF3A3A3C">
            <TextBlock x:Name="IncomingInitials" FontFamily="{StaticResource UiFont}" FontSize="19" FontWeight="SemiBold"
                       Foreground="#FFFFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,2"/>
          </Border>
          <Image x:Name="IncomingAppIcon" Width="20" Height="20" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                 Margin="0,0,-3,-3" RenderOptions.BitmapScalingMode="HighQuality"/>
          <StackPanel Grid.Column="1" Margin="14,0,10,0" VerticalAlignment="Center">
            <TextBlock x:Name="IncomingName" FontFamily="{StaticResource UiFont}" FontSize="16.5" FontWeight="SemiBold"
                       Foreground="#FFFFFFFF" TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="IncomingSub" Margin="0,2,0,0" FontFamily="{StaticResource UiFont}" FontSize="12.5"
                       Foreground="#A6FFFFFF" TextTrimming="CharacterEllipsis"/>
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
            <Button x:Name="DeclineButton" Style="{StaticResource CircleButton}" Width="48" Height="48" Background="#FFFF3B30"
                    Foreground="#FFFFFFFF" FontSize="20" Content="&#xE778;" ToolTip="Decline"/>
            <Button x:Name="AcceptButton" Style="{StaticResource CircleButton}" Width="48" Height="48" Margin="16,0,0,0"
                    Background="#FF30D158" Foreground="#FFFFFFFF" FontSize="19" Content="&#xE717;" ToolTip="Accept"/>
          </StackPanel>
        </Grid>

        <!-- ongoing call -->
        <Grid x:Name="ExpCall" Margin="18,16,18,6" Visibility="Collapsed">
          <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="52"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border Width="52" Height="52" CornerRadius="15" Background="#FF1C1C1E">
              <Grid>
                <TextBlock x:Name="CallIconGlyph" Text="&#xE717;" FontFamily="{StaticResource IconFont}" FontSize="22"
                           Foreground="#FF30D158" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Image x:Name="CallIcon" Width="34" Height="34" RenderOptions.BitmapScalingMode="HighQuality"/>
              </Grid>
            </Border>
            <StackPanel Grid.Column="1" Margin="14,0,10,0" VerticalAlignment="Center">
              <TextBlock x:Name="CallTitle" FontFamily="{StaticResource UiFont}" FontSize="15.5" FontWeight="SemiBold"
                         Foreground="#FFFFFFFF" TextTrimming="CharacterEllipsis"/>
              <TextBlock x:Name="CallStatus" Margin="0,2,0,0" FontFamily="{StaticResource UiFont}" FontSize="12.5"
                         Foreground="#FF30D158" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,4,0,0">
              <Border x:Name="MicChip" Background="#1CFFFFFF" CornerRadius="100" Padding="8,3,9,4" Margin="6,0,0,0">
                <StackPanel Orientation="Horizontal">
                  <Ellipse Width="6" Height="6" Fill="#FFFF9F0A" VerticalAlignment="Center"/>
                  <TextBlock x:Name="MicChipText" Text="Mic" FontFamily="{StaticResource UiFont}" FontSize="11" FontWeight="SemiBold"
                             Foreground="#D9FFFFFF" Margin="5,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
              </Border>
              <Border x:Name="CamChip" Background="#1CFFFFFF" CornerRadius="100" Padding="8,3,9,4" Margin="6,0,0,0">
                <StackPanel Orientation="Horizontal">
                  <Ellipse Width="6" Height="6" Fill="#FF30D158" VerticalAlignment="Center"/>
                  <TextBlock Text="Camera" FontFamily="{StaticResource UiFont}" FontSize="11" FontWeight="SemiBold"
                             Foreground="#D9FFFFFF" Margin="5,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
              </Border>
            </StackPanel>
          </Grid>
          <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
            <StackPanel Margin="0,0,30,0">
              <Button x:Name="MuteButton" Style="{StaticResource CircleButton}" Width="50" Height="50" Background="#2EFFFFFF"
                      FontSize="19" Content="&#xE720;"/>
              <TextBlock x:Name="MuteLabel" Text="Mute" FontFamily="{StaticResource UiFont}" FontSize="11" Foreground="#A6FFFFFF"
                         HorizontalAlignment="Center" Margin="0,5,0,0"/>
            </StackPanel>
            <StackPanel Margin="0,0,30,0">
              <Button x:Name="CallOpenButton" Style="{StaticResource CircleButton}" Width="50" Height="50" Background="#2EFFFFFF"
                      FontSize="17" Content="&#xE8A7;"/>
              <TextBlock Text="Open" FontFamily="{StaticResource UiFont}" FontSize="11" Foreground="#A6FFFFFF"
                         HorizontalAlignment="Center" Margin="0,5,0,0"/>
            </StackPanel>
            <StackPanel>
              <Button x:Name="EndButton" Style="{StaticResource CircleButton}" Width="50" Height="50" Background="#FFFF3B30"
                      Foreground="#FFFFFFFF" FontSize="20" Content="&#xE778;"/>
              <TextBlock Text="End" FontFamily="{StaticResource UiFont}" FontSize="11" Foreground="#A6FFFFFF"
                         HorizontalAlignment="Center" Margin="0,5,0,0"/>
            </StackPanel>
          </StackPanel>
        </Grid>

        <!-- shown while files are dragged over the island: keep them on the shelf, or send them to the phone (AirDrop-style) -->
        <Grid x:Name="ExpDrop" Margin="18,16,18,14" Height="104" Visibility="Collapsed">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition x:Name="DropSendCol" Width="*"/>
          </Grid.ColumnDefinitions>
          <Grid x:Name="DropKeep" Margin="0,0,6,0">
            <Rectangle x:Name="DropKeepBox" RadiusX="20" RadiusY="20" Stroke="#59FFFFFF" StrokeThickness="1.5" StrokeDashArray="5 4" Fill="#0DFFFFFF"/>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
              <TextBlock Text="&#xE896;" FontFamily="{StaticResource IconFont}" FontSize="22" Foreground="#CCFFFFFF" HorizontalAlignment="Center"/>
              <TextBlock Text="Keep on shelf" FontFamily="{StaticResource UiFont}" FontSize="13" Foreground="#CCFFFFFF"
                         HorizontalAlignment="Center" Margin="0,8,0,0"/>
            </StackPanel>
          </Grid>
          <Grid x:Name="DropSend" Grid.Column="1" Margin="6,0,0,0">
            <Rectangle x:Name="DropSendBox" RadiusX="20" RadiusY="20" Stroke="#5930D158" StrokeThickness="1.5" StrokeDashArray="5 4" Fill="#0D30D158"/>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
              <TextBlock Text="&#xE8EA;" FontFamily="{StaticResource IconFont}" FontSize="22" Foreground="#FF30D158" HorizontalAlignment="Center"/>
              <TextBlock x:Name="DropSendText" Text="Send to phone" FontFamily="{StaticResource UiFont}" FontSize="13" Foreground="#CCFFFFFF"
                         HorizontalAlignment="Center" Margin="0,8,0,0"/>
            </StackPanel>
          </Grid>
        </Grid>

        <!-- now playing -->
        <Grid x:Name="ExpMedia" Margin="18,16,18,4">
          <Grid.RowDefinitions>
            <RowDefinition Height="58"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <Grid x:Name="MediaInfo">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="58"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="ArtButton" Style="{StaticResource BareButton}" ToolTip="Open player">
              <Grid Width="58" Height="58">
                <Border x:Name="ArtPlaceholder" CornerRadius="14" Background="#1FFFFFFF">
                  <TextBlock Text="&#xEC4F;" FontFamily="{StaticResource IconFont}" FontSize="22" Foreground="#80FFFFFF"
                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <Border x:Name="ArtLarge" CornerRadius="14" RenderOptions.BitmapScalingMode="HighQuality"/>
              </Grid>
            </Button>
            <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
              <TextBlock x:Name="Title" FontFamily="{StaticResource UiFont}" FontSize="15.5" FontWeight="SemiBold"
                         Foreground="#FFFFFFFF" TextTrimming="CharacterEllipsis"/>
              <TextBlock x:Name="Artist" Margin="0,2,0,0" FontFamily="{StaticResource UiFont}" FontSize="12.5"
                         Foreground="#A6FFFFFF" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <StackPanel Grid.Column="2" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,2,0,0">
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
              <Button x:Name="SourceChip" Style="{StaticResource ChipButton}" HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal">
                  <TextBlock x:Name="SourceSwitch" FontFamily="{StaticResource UiFont}" FontSize="10.5" FontWeight="SemiBold" Foreground="#8CFFFFFF"
                             Margin="0,0,6,1" VerticalAlignment="Center" Visibility="Collapsed"/>
                  <Image x:Name="SourceIcon" Width="20" Height="20" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                  <TextBlock x:Name="SourceText" FontFamily="{StaticResource UiFont}" FontSize="11" FontWeight="SemiBold" Foreground="#99FFFFFF"
                             VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
              <Button x:Name="DismissButton" Style="{StaticResource CircleButton}" Width="24" Height="24" FontSize="9" Margin="2,0,-6,0"
                      Foreground="#8CFFFFFF" Content="&#xE711;" ToolTip="Remove from Isle (it comes back if it plays again)"/>
              </StackPanel>
              <StackPanel x:Name="ExpBars" Orientation="Horizontal" HorizontalAlignment="Right" Height="16" Margin="0,12,6,0"/>
            </StackPanel>
          </Grid>

          <!-- progress -->
          <Grid x:Name="ProgressRow" Grid.Row="1" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="42"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="42"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="Elapsed" FontFamily="{StaticResource UiFont}" FontSize="11" Foreground="#8CFFFFFF" VerticalAlignment="Center" Text="0:00"/>
            <Grid x:Name="SeekArea" Grid.Column="1" Height="18" Background="Transparent" Cursor="Hand" Margin="2,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SeekDone" Width="0*"/>
                <ColumnDefinition x:Name="SeekLeft" Width="1*"/>
              </Grid.ColumnDefinitions>
              <Border x:Name="SeekTrack" Grid.ColumnSpan="2" Height="4" CornerRadius="2" Background="#2EFFFFFF" VerticalAlignment="Center"/>
              <Border x:Name="SeekFill" Height="4" CornerRadius="2" VerticalAlignment="Center"/>
            </Grid>
            <TextBlock x:Name="Remaining" Grid.Column="2" FontFamily="{StaticResource UiFont}" FontSize="11" Foreground="#8CFFFFFF"
                       VerticalAlignment="Center" TextAlignment="Right" Text="0:00"/>
          </Grid>

          <!-- controls -->
          <Grid Grid.Row="2" Margin="0,6,0,0" Height="48">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="-7,0,0,0">
              <Button x:Name="VolButton" Style="{StaticResource CircleButton}" Width="32" Height="32" FontSize="14" Content="&#xE995;" ToolTip="Mute"/>
              <Grid x:Name="VolArea" Width="96" Height="18" Background="Transparent" Cursor="Hand" Margin="3,0,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition x:Name="VolDone" Width="1*"/>
                  <ColumnDefinition x:Name="VolLeft" Width="1*"/>
                </Grid.ColumnDefinitions>
                <Border x:Name="VolTrack" Grid.ColumnSpan="2" Height="4" CornerRadius="2" Background="#2EFFFFFF" VerticalAlignment="Center"/>
                <Border x:Name="VolFill" Height="4" CornerRadius="2" Background="#F2FFFFFF" VerticalAlignment="Center"/>
              </Grid>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
              <Button x:Name="PrevButton" Style="{StaticResource CircleButton}" Width="40" Height="40">
                <Path Fill="#F2FFFFFF" RenderTransformOrigin="0.5,0.5"
                      Data="M0.5,1.6 C0.5,0.5 1.7,-0.1 2.6,0.5 L11.2,6.2 C12,6.7 12,7.9 11.2,8.4 L2.6,14.1 C1.7,14.7 0.5,14.1 0.5,13 Z M13.4,0.6 L15.4,0.6 C15.8,0.6 16,0.9 16,1.2 L16,13.4 C16,13.7 15.8,14 15.4,14 L13.4,14 C13,14 12.8,13.7 12.8,13.4 L12.8,1.2 C12.8,0.9 13,0.6 13.4,0.6 Z">
                  <Path.RenderTransform><ScaleTransform ScaleX="-1"/></Path.RenderTransform>
                </Path>
              </Button>
              <Button x:Name="PlayButton" Style="{StaticResource CircleButton}" Width="46" Height="46" Margin="12,0">
                <Grid>
                  <Path x:Name="PlayIcon" Fill="#FF0A0A0C" Margin="3,0,0,0"
                        Data="M1,1.8 C1,0.6 2.3,-0.1 3.3,0.5 L14.2,7 C15.2,7.6 15.2,9 14.2,9.6 L3.3,16.1 C2.3,16.7 1,16 1,14.8 Z"/>
                  <Path x:Name="PauseIcon" Stroke="#FF0A0A0C" StrokeThickness="4.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                        Data="M2.5,2 L2.5,14.5 M10.5,2 L10.5,14.5" Visibility="Collapsed"/>
                </Grid>
              </Button>
              <Button x:Name="NextButton" Style="{StaticResource CircleButton}" Width="40" Height="40">
                <Path Fill="#F2FFFFFF"
                      Data="M0.5,1.6 C0.5,0.5 1.7,-0.1 2.6,0.5 L11.2,6.2 C12,6.7 12,7.9 11.2,8.4 L2.6,14.1 C1.7,14.7 0.5,14.1 0.5,13 Z M13.4,0.6 L15.4,0.6 C15.8,0.6 16,0.9 16,1.2 L16,13.4 C16,13.7 15.8,14 15.4,14 L13.4,14 C13,14 12.8,13.7 12.8,13.4 L12.8,1.2 C12.8,0.9 13,0.6 13.4,0.6 Z"/>
              </Button>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,-7,0">
              <Button x:Name="LikeButton" Style="{StaticResource CircleButton}" Width="32" Height="32" ToolTip="Like" Visibility="Collapsed">
                <Path x:Name="LikeIcon" Width="15" Height="13.5" Stretch="Uniform" Stroke="#F2FFFFFF" StrokeThickness="1.6" Fill="Transparent"
                      StrokeLineJoin="Round" RenderTransformOrigin="0.5,0.5"
                      Data="M8,14.2 C7.6,14.2 1,9.9 1,5.4 C1,3.2 2.7,1.6 4.7,1.6 C6.1,1.6 7.3,2.4 8,3.6 C8.7,2.4 9.9,1.6 11.3,1.6 C13.3,1.6 15,3.2 15,5.4 C15,9.9 8.4,14.2 8,14.2 Z">
                  <Path.RenderTransform><ScaleTransform x:Name="LikeScale" ScaleX="1" ScaleY="1"/></Path.RenderTransform>
                </Path>
              </Button>
              <Button x:Name="OpenAppButton" Style="{StaticResource CircleButton}" Width="32" Height="32" FontSize="13"
                      Content="&#xE8A7;" ToolTip="Open player"/>
            </StackPanel>
          </Grid>
        </Grid>

        <!-- nothing playing: clock, date, battery -->
        <Grid x:Name="ExpIdle" Margin="24,14,24,10" Visibility="Collapsed">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock x:Name="BigClock" FontFamily="{StaticResource UiFont}" FontSize="38" FontWeight="Light" Foreground="#FFFFFFFF" Margin="-2,-4,0,0"/>
            <TextBlock x:Name="DateText" FontFamily="{StaticResource UiFont}" FontSize="13" Foreground="#A6FFFFFF" Margin="0,-2,0,0"/>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
              <TextBlock Text="&#xEC4F;" FontFamily="{StaticResource IconFont}" FontSize="11" Foreground="#66FFFFFF" VerticalAlignment="Center"/>
              <TextBlock Text="Nothing playing" FontFamily="{StaticResource UiFont}" FontSize="11.5" Foreground="#66FFFFFF" Margin="6,0,0,1" VerticalAlignment="Center"/>
            </StackPanel>
          </StackPanel>
          <StackPanel x:Name="BatteryBlock" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
              <TextBlock x:Name="BatteryBolt" Text="&#xE945;" FontFamily="{StaticResource IconFont}" FontSize="13" Foreground="#FF5BE37D"
                         VerticalAlignment="Center" Margin="0,2,5,0"/>
              <TextBlock x:Name="BatteryPct" FontFamily="{StaticResource UiFont}" FontSize="21" FontWeight="SemiBold" Foreground="#FFFFFFFF"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
              <Border Width="34" Height="16" CornerRadius="4.5" BorderBrush="#80FFFFFF" BorderThickness="1.3" Padding="2">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="BattDone" Width="1*"/>
                    <ColumnDefinition x:Name="BattLeft" Width="0*"/>
                  </Grid.ColumnDefinitions>
                  <Border x:Name="BattFill" CornerRadius="2.2" Background="#FFFFFFFF"/>
                </Grid>
              </Border>
              <Border Width="2.5" Height="6" CornerRadius="0,1.5,1.5,0" Background="#80FFFFFF" Margin="1.5,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock x:Name="BatteryState" FontFamily="{StaticResource UiFont}" FontSize="11" Foreground="#80FFFFFF" HorizontalAlignment="Right" Margin="0,6,0,0"/>
          </StackPanel>
        </Grid>

        <!-- your earbuds, while connected -->
        <Border x:Name="BudsRow" Margin="18,8,18,2" Padding="8,6,10,6" CornerRadius="16" Background="#12FFFFFF"
                BorderBrush="#1CFFFFFF" BorderThickness="1" Visibility="Collapsed">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border x:Name="BudsRowArt" Width="32" Height="32" CornerRadius="10" Background="#1FFFFFFF"/>
            <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
              <TextBlock x:Name="BudsRowName" FontFamily="{StaticResource UiFont}" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFFFF"
                         TextTrimming="CharacterEllipsis"/>
              <TextBlock x:Name="BudsRowStatus" FontFamily="{StaticResource UiFont}" FontSize="11" Foreground="#8CFFFFFF" Margin="0,1,0,0"
                         TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <Grid Grid.Column="2" Width="36" Height="36" VerticalAlignment="Center">
              <Ellipse Stroke="#26FFFFFF" StrokeThickness="3.5"/>
              <Path x:Name="BudsRowRing" Stroke="#FF30D158" StrokeThickness="3.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
              <TextBlock x:Name="BudsRowPct" FontFamily="{StaticResource UiFont}" FontSize="10.5" FontWeight="SemiBold" Foreground="#FFFFFFFF"
                         HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,1"/>
            </Grid>
          </Grid>
        </Border>

        <!-- your phone -->
        <Border x:Name="PhoneRow" Margin="18,8,18,2" Padding="8,6,6,6" CornerRadius="16" Background="#12FFFFFF"
                BorderBrush="#1CFFFFFF" BorderThickness="1" Visibility="Collapsed">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid Width="32" Height="32">
              <Border CornerRadius="10" Background="#1FFFFFFF"/>
              <TextBlock Text="&#xE8EA;" FontFamily="{StaticResource IconFont}" FontSize="16" Foreground="#E6FFFFFF"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
              <Ellipse x:Name="PhoneDot" Width="9" Height="9" Fill="#FF8E8E93" Stroke="#FF141416" StrokeThickness="2"
                       HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-2,-2"/>
            </Grid>
            <StackPanel x:Name="PhoneInfo" Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center" Background="Transparent" Cursor="Hand">
              <TextBlock x:Name="PhoneName" FontFamily="{StaticResource UiFont}" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFFFF"
                         TextTrimming="CharacterEllipsis"/>
              <TextBlock x:Name="PhoneStatus" FontFamily="{StaticResource UiFont}" FontSize="11" Foreground="#8CFFFFFF" Margin="0,1,0,0"
                         TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
              <Button x:Name="PhoneMirrorButton" Style="{StaticResource CircleButton}" Width="32" Height="32" FontSize="14" Content="&#xEC15;" ToolTip="Show the phone's screen here"/>
              <Button x:Name="PhoneRingButton" Style="{StaticResource CircleButton}" Width="32" Height="32" FontSize="14" Content="&#xEA8F;" ToolTip="Find my phone (rings it)"/>
              <Button x:Name="PhoneClipButton" Style="{StaticResource CircleButton}" Width="32" Height="32" FontSize="14" Content="&#xE8C8;" ToolTip="Send this PC's clipboard to the phone"/>
              <Button x:Name="PhoneSendButton" Style="{StaticResource CircleButton}" Width="32" Height="32" FontSize="14" Content="&#xE724;" ToolTip="Send files to the phone"/>
              <Button x:Name="PhoneSmsButton" Style="{StaticResource CircleButton}" Width="32" Height="32" FontSize="14" Content="&#xE8BD;" ToolTip="Messages"/>
              <Button x:Name="PhoneLinkButton" Style="{StaticResource CircleButton}" Width="32" Height="32" FontSize="13" Content="&#xE8A7;" ToolTip="Open Phone Link (calls, photos)"/>
            </StackPanel>
          </Grid>
        </Border>

        <!-- file shelf -->
        <Grid x:Name="ShelfArea" Margin="18,4,18,0" Visibility="Collapsed">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <Grid Margin="2,0,0,2">
            <TextBlock Text="Shelf" FontFamily="{StaticResource UiFont}" FontSize="11" FontWeight="SemiBold" Foreground="#73FFFFFF"
                       VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
              <Button x:Name="ShelfSend" Style="{StaticResource TextButton}" Content="Send to phone" Margin="0,0,6,0"/>
              <Button x:Name="ShelfClear" Style="{StaticResource TextButton}" Content="Clear"/>
            </StackPanel>
          </Grid>
          <StackPanel x:Name="ShelfRow" Grid.Row="1" Orientation="Horizontal"/>
        </Grid>

        <!-- quick apps -->
        <Border x:Name="AppsDivider" Height="1" Margin="18,6,18,0" Background="#17FFFFFF"/>
        <StackPanel x:Name="AppsRow" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,7,0,9"/>
      </StackPanel>
    </Grid>
  </Grid>
</Grid>
