<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Grid.Resources>
    <FontFamily x:Key="Ui">Segoe UI</FontFamily>
    <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="#FF151518"/>
      <Setter Property="CornerRadius" Value="16"/>
      <Setter Property="Padding" Value="16,14,16,14"/>
      <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>
    <Style x:Key="H" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource Ui}"/>
      <Setter Property="FontSize" Value="14.5"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="#FFFFFFFF"/>
    </Style>
    <Style x:Key="Sub" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource Ui}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="#8CFFFFFF"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="Label" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource Ui}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Foreground" Value="#E6FFFFFF"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="Ghost" TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Foreground" Value="#F2FFFFFF"/>
      <Setter Property="FontFamily" Value="{StaticResource Ui}"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="Height" Value="34"/>
      <Setter Property="Padding" Value="14,0"/>
      <Setter Property="Background" Value="#1FFFFFFF"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <Border Background="{TemplateBinding Background}" CornerRadius="17"/>
              <Border x:Name="Hover" Background="#FFFFFFFF" Opacity="0" CornerRadius="17"/>
              <ContentPresenter x:Name="Cp" Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Hover" Property="Opacity" Value="0.1"/></Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Cp" Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="0.95" ScaleY="0.95"/></Setter.Value></Setter>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="WinBtn" TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bg" Width="32" Height="32" CornerRadius="16" Background="Transparent">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bg" Property="Background" Value="#1FFFFFFF"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Switch" TargetType="CheckBox">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Grid Width="42" Height="24" Background="Transparent">
              <Border x:Name="Track" CornerRadius="12" Background="#38FFFFFF"/>
              <Ellipse x:Name="Knob" Width="18" Height="18" Fill="#FFFFFFFF" HorizontalAlignment="Left" Margin="3,0,0,0"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Track" Property="Background" Value="#FF30D158"/>
                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                <Setter TargetName="Knob" Property="Margin" Value="0,0,3,0"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Seg" TargetType="RadioButton">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Foreground" Value="#B3FFFFFF"/>
      <Setter Property="FontFamily" Value="{StaticResource Ui}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Bg" CornerRadius="13" Padding="12,4,12,5" Background="Transparent">
              <ContentPresenter HorizontalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="#3DFFFFFF"/>
                <Setter Property="Foreground" Value="#FFFFFFFF"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Grid.Resources>

  <Border x:Name="Frame" Background="#FF0B0B0E">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <!-- title bar -->
      <Grid x:Name="TitleBar" Height="56" Background="Transparent" Margin="18,0,12,0">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Image x:Name="AppIcon" Width="26" Height="26" RenderOptions.BitmapScalingMode="HighQuality"/>
          <TextBlock Text="Isle" FontFamily="{StaticResource Ui}" FontSize="17" FontWeight="SemiBold" Foreground="#FFFFFFFF"
                     Margin="10,0,0,1" VerticalAlignment="Center"/>
          <Border CornerRadius="10" Background="#1F30D158" Padding="8,2,9,3" Margin="12,0,0,0" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal">
              <Ellipse Width="6" Height="6" Fill="#FF30D158" VerticalAlignment="Center"/>
              <TextBlock Text="Running" FontFamily="{StaticResource Ui}" FontSize="11" FontWeight="SemiBold" Foreground="#FF30D158" Margin="5,0,0,0"/>
            </StackPanel>
          </Border>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <Button x:Name="MinButton" Style="{StaticResource WinBtn}" ToolTip="Minimize">
            <TextBlock Text="&#xE921;" FontFamily="{StaticResource Icons}" FontSize="10" Foreground="#B3FFFFFF"/>
          </Button>
          <Button x:Name="CloseButton" Style="{StaticResource WinBtn}" ToolTip="Close (Isle keeps running)">
            <TextBlock Text="&#xE8BB;" FontFamily="{StaticResource Icons}" FontSize="10" Foreground="#B3FFFFFF"/>
          </Button>
        </StackPanel>
      </Grid>

      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <StackPanel Margin="18,2,18,16">

          <!-- island -->
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <Grid>
                <StackPanel Margin="0,0,90,0">
                  <TextBlock Text="Island" Style="{StaticResource H}"/>
                  <TextBlock Style="{StaticResource Sub}" Margin="0,3,0,0"
                             Text="Lives at the top of your screen. Rest the cursor on it for a moment, or press Ctrl+Alt+I. Clicks pass through it to your tabs."/>
                </StackPanel>
                <Button x:Name="ShowIsland" Style="{StaticResource Ghost}" Content="Show it" HorizontalAlignment="Right" VerticalAlignment="Top"/>
              </Grid>
              <Border Height="1" Background="#14FFFFFF" Margin="0,14,0,10"/>
              <Grid Margin="0,4">
                <TextBlock Text="Style" Style="{StaticResource Label}"/>
                <Border HorizontalAlignment="Right" Background="#14FFFFFF" CornerRadius="15" Padding="2">
                  <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="StyleNotch" GroupName="style" Style="{StaticResource Seg}" Content="Notch"/>
                    <RadioButton x:Name="StyleFloating" GroupName="style" Style="{StaticResource Seg}" Content="Floating"/>
                  </StackPanel>
                </Border>
              </Grid>
              <Grid Margin="0,8">
                <TextBlock Text="When nothing is playing" Style="{StaticResource Label}"/>
                <Border HorizontalAlignment="Right" Background="#14FFFFFF" CornerRadius="15" Padding="2">
                  <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="IdleClock" GroupName="idle" Style="{StaticResource Seg}" Content="Clock"/>
                    <RadioButton x:Name="IdleMinimal" GroupName="idle" Style="{StaticResource Seg}" Content="Minimal"/>
                  </StackPanel>
                </Border>
              </Grid>
              <Grid Margin="0,4,0,8">
                <StackPanel Margin="0,0,60,0">
                  <TextBlock Text="Open only from the top edge" Style="{StaticResource Label}"/>
                  <TextBlock Text="Push the cursor against the top of the screen to open. Hovering your tabs never opens it." Style="{StaticResource Sub}" Margin="0,1,0,0"/>
                </StackPanel>
                <CheckBox x:Name="EdgeOpen" Style="{StaticResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
              </Grid>
              <Grid Margin="0,4,0,8">
                <StackPanel Margin="0,0,60,0">
                  <TextBlock Text="See through on hover" Style="{StaticResource Label}"/>
                  <TextBlock Text="The pill fades while your cursor is over it, so the tab underneath shows." Style="{StaticResource Sub}" Margin="0,1,0,0"/>
                </StackPanel>
                <CheckBox x:Name="FadeHover" Style="{StaticResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
              </Grid>
              <Grid Margin="0,4">
                <TextBlock Text="Start with Windows" Style="{StaticResource Label}"/>
                <CheckBox x:Name="AutoStart" Style="{StaticResource Switch}" HorizontalAlignment="Right"/>
              </Grid>
              <Grid Margin="0,8,0,0">
                <TextBlock Text="Hide during fullscreen video and games" Style="{StaticResource Label}"/>
                <CheckBox x:Name="HideFullscreen" Style="{StaticResource Switch}" HorizontalAlignment="Right"/>
              </Grid>
            </StackPanel>
          </Border>

          <!-- phone -->
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid Width="40" Height="40">
                  <Border CornerRadius="12" Background="#1FFFFFFF"/>
                  <TextBlock Text="&#xE8EA;" FontFamily="{StaticResource Icons}" FontSize="19" Foreground="#E6FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  <Ellipse x:Name="PhoneDot" Width="10" Height="10" Fill="#FF8E8E93" Stroke="#FF151518" StrokeThickness="2"
                           HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-2,-2"/>
                </Grid>
                <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                  <TextBlock x:Name="PhoneTitle" Text="Phone" Style="{StaticResource H}"/>
                  <TextBlock x:Name="PhoneSub" Style="{StaticResource Sub}" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                  <TextBlock x:Name="PhoneBolt" Text="&#xE945;" FontFamily="{StaticResource Icons}" FontSize="12" Foreground="#FF30D158"
                             VerticalAlignment="Center" Margin="0,1,4,0" Visibility="Collapsed"/>
                  <TextBlock x:Name="PhoneBattery" FontFamily="{StaticResource Ui}" FontSize="17" FontWeight="SemiBold" Foreground="#FFFFFFFF"/>
                </StackPanel>
              </Grid>
              <WrapPanel Margin="0,14,0,0">
                <Button x:Name="MirrorPhone" Style="{StaticResource Ghost}" Margin="0,0,8,8" Background="#FF7CF2C2" Foreground="#FF0A0A0C">
                  <StackPanel Orientation="Horizontal"><TextBlock Text="&#xEC15;" FontFamily="{StaticResource Icons}" FontSize="13" Margin="0,1,7,0"/><TextBlock Text="Show phone screen"/></StackPanel>
                </Button>
                <Button x:Name="RingPhone" Style="{StaticResource Ghost}" Margin="0,0,8,8">
                  <StackPanel Orientation="Horizontal"><TextBlock Text="&#xEA8F;" FontFamily="{StaticResource Icons}" FontSize="13" Margin="0,1,7,0"/><TextBlock Text="Ring"/></StackPanel>
                </Button>
                <Button x:Name="SendClip" Style="{StaticResource Ghost}" Margin="0,0,8,8">
                  <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8C8;" FontFamily="{StaticResource Icons}" FontSize="13" Margin="0,1,7,0"/><TextBlock Text="Send clipboard"/></StackPanel>
                </Button>
                <Button x:Name="SendFiles" Style="{StaticResource Ghost}" Margin="0,0,8,8">
                  <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE724;" FontFamily="{StaticResource Icons}" FontSize="13" Margin="0,1,7,0"/><TextBlock Text="Send files"/></StackPanel>
                </Button>
                <Button x:Name="Messages" Style="{StaticResource Ghost}" Margin="0,0,8,8">
                  <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8BD;" FontFamily="{StaticResource Icons}" FontSize="13" Margin="0,1,7,0"/><TextBlock Text="Messages"/></StackPanel>
                </Button>
                <Button x:Name="PhoneLink" Style="{StaticResource Ghost}" Margin="0,0,8,8">
                  <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8A7;" FontFamily="{StaticResource Icons}" FontSize="13" Margin="0,1,7,0"/><TextBlock Text="Phone Link"/></StackPanel>
                </Button>
              </WrapPanel>
              <Border Height="1" Background="#14FFFFFF" Margin="0,6,0,12"/>
              <Grid>
                <StackPanel Margin="0,0,150,0">
                  <TextBlock Text="Isle for Android" Style="{StaticResource Label}" FontWeight="SemiBold"/>
                  <TextBlock x:Name="LinkSub" Style="{StaticResource Sub}" Margin="0,2,0,0"
                             Text="Install once on your phone: clipboard, battery and ring over Bluetooth. No other apps."/>
                </StackPanel>
                <Button x:Name="GetPhoneApp" Style="{StaticResource Ghost}" Content="Get the phone app" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Background="#FF7CF2C2" Foreground="#FF0A0A0C"/>
              </Grid>
            </StackPanel>
          </Border>

          <!-- clipboard from phone -->
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <Grid>
                <TextBlock Text="Copied on your phone" Style="{StaticResource H}"/>
                <Button x:Name="ClearClips" Style="{StaticResource Ghost}" Content="Clear" Height="28" Padding="10,0" HorizontalAlignment="Right"/>
              </Grid>
              <TextBlock x:Name="ClipEmpty" Style="{StaticResource Sub}" Margin="0,6,0,0"
                         Text="Nothing yet. Copy something on your phone and send it to the laptop; it shows up here and is ready for Ctrl+V."/>
              <StackPanel x:Name="ClipList" Margin="0,8,0,0"/>
            </StackPanel>
          </Border>

          <!-- quick apps -->
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <Grid>
                <StackPanel Margin="0,0,110,0">
                  <TextBlock Text="Quick apps" Style="{StaticResource H}"/>
                  <TextBlock Text="The app icons at the bottom of the island. &#xD7; removes, &#x2039; &#x203A; move." Style="{StaticResource Sub}" Margin="0,3,0,0"/>
                </StackPanel>
                <Button x:Name="AddApp" Style="{StaticResource Ghost}" Content="+ Add app" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Background="#FF7CF2C2" Foreground="#FF0A0A0C"/>
              </Grid>
              <WrapPanel x:Name="QuickAppsList" Margin="0,12,0,0"/>
            </StackPanel>
          </Border>

          <!-- more -->
          <Border Style="{StaticResource Card}">
            <WrapPanel>
              <Button x:Name="EditApps" Style="{StaticResource Ghost}" Content="Open settings file" Margin="0,0,8,0"/>
              <Button x:Name="ReloadSettings" Style="{StaticResource Ghost}" Content="Reload settings" Margin="0,0,8,0"/>
              <Button x:Name="QuitIsle" Style="{StaticResource Ghost}" Content="Quit Isle" Foreground="#FFFF6961"/>
            </WrapPanel>
          </Border>

          <TextBlock x:Name="VersionText" Style="{StaticResource Sub}" HorizontalAlignment="Center" Margin="0,2,0,0" Foreground="#59FFFFFF"/>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Border>
</Grid>
