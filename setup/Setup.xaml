<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      TextOptions.TextFormattingMode="Ideal">
  <Grid.Resources>
    <FontFamily x:Key="Ui">Segoe UI</FontFamily>
    <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <Style x:Key="Primary" TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Height" Value="44"/>
      <Setter Property="Background" Value="#FF7CF2C2"/>
      <Setter Property="Foreground" Value="#FF0A0A0C"/>
      <Setter Property="FontFamily" Value="{StaticResource Ui}"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <Border Background="{TemplateBinding Background}" CornerRadius="22"/>
              <Border x:Name="Hover" Background="#FFFFFFFF" CornerRadius="22" Opacity="0"/>
              <ContentPresenter x:Name="Cp" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Hover" Property="Opacity" Value="0.14"/></Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Cp" Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="0.96" ScaleY="0.96"/></Setter.Value></Setter>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Close" TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bg" Width="30" Height="30" CornerRadius="15" Background="Transparent">
              <TextBlock Text="&#xE8BB;" FontFamily="{StaticResource Icons}" FontSize="10" Foreground="#99FFFFFF"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bg" Property="Background" Value="#1FFFFFFF"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Check" TargetType="CheckBox">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="#D9FFFFFF"/>
      <Setter Property="FontFamily" Value="{StaticResource Ui}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <StackPanel Orientation="Horizontal" Background="Transparent">
              <Border x:Name="Box" Width="18" Height="18" CornerRadius="5" BorderBrush="#59FFFFFF" BorderThickness="1.4" Background="Transparent">
                <TextBlock x:Name="Tick" Text="&#xE73E;" FontFamily="{StaticResource Icons}" FontSize="11" Foreground="#FF0A0A0C"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
              </Border>
              <ContentPresenter Margin="10,0,0,1" VerticalAlignment="Center"/>
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Box" Property="Background" Value="#FF7CF2C2"/>
                <Setter TargetName="Box" Property="BorderBrush" Value="#FF7CF2C2"/>
                <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Grid.Resources>

  <Border x:Name="Card" Margin="16" CornerRadius="22" Background="#FF0B0B0E" BorderBrush="#24FFFFFF" BorderThickness="1">
    <Border.Effect>
      <DropShadowEffect BlurRadius="26" ShadowDepth="5" Opacity="0.45" Color="#FF000000"/>
    </Border.Effect>
    <Grid>
      <Button x:Name="CloseButton" Style="{StaticResource Close}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,12,0"/>
      <StackPanel Margin="36,34,36,26">

        <!-- a tiny island as the hero -->
        <Border Width="170" Height="36" CornerRadius="18" Background="#FF000000" BorderBrush="#26FFFFFF" BorderThickness="1" HorizontalAlignment="Center">
          <Grid Margin="7,0,15,0">
            <Image x:Name="AppIcon" Width="24" Height="24" HorizontalAlignment="Left" RenderOptions.BitmapScalingMode="HighQuality"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
              <Rectangle Width="3" Height="7" RadiusX="1.5" RadiusY="1.5" Fill="#FF7CF2C2" VerticalAlignment="Center"/>
              <Rectangle Width="3" Height="14" RadiusX="1.5" RadiusY="1.5" Fill="#FF7CF2C2" VerticalAlignment="Center" Margin="2.5,0,0,0"/>
              <Rectangle Width="3" Height="10" RadiusX="1.5" RadiusY="1.5" Fill="#FF7CF2C2" VerticalAlignment="Center" Margin="2.5,0,0,0"/>
              <Rectangle Width="3" Height="5" RadiusX="1.5" RadiusY="1.5" Fill="#FF7CF2C2" VerticalAlignment="Center" Margin="2.5,0,0,0"/>
            </StackPanel>
          </Grid>
        </Border>

        <TextBlock x:Name="Heading" Text="Isle" FontFamily="{StaticResource Ui}" FontSize="26" FontWeight="SemiBold" Foreground="#FFFFFFFF"
                   HorizontalAlignment="Center" Margin="0,20,0,0"/>
        <TextBlock x:Name="Sub" Text="Your own dynamic island for Windows" FontFamily="{StaticResource Ui}" FontSize="13" Foreground="#99FFFFFF"
                   HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,5,0,0"/>

        <StackPanel x:Name="Options" Margin="10,24,0,0">
          <CheckBox x:Name="AutoStart" Style="{StaticResource Check}" Content="Start with Windows" IsChecked="True"/>
          <CheckBox x:Name="DesktopShortcut" Style="{StaticResource Check}" Content="Add a desktop shortcut" Margin="0,12,0,0"/>
          <CheckBox x:Name="RemoveSettings" Style="{StaticResource Check}" Content="Also delete my settings and shelf" Visibility="Collapsed"/>
        </StackPanel>

        <Button x:Name="Primary" Style="{StaticResource Primary}" Content="Install" Margin="0,26,0,0" IsDefault="True"/>
        <TextBlock x:Name="Status" FontFamily="{StaticResource Ui}" FontSize="11.5" Foreground="#66FFFFFF" HorizontalAlignment="Center"
                   TextAlignment="Center" TextWrapping="Wrap" Margin="0,12,0,0"/>
      </StackPanel>
    </Grid>
  </Border>
</Grid>
